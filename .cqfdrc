[project]
org='rte'
name='vm_manager'

flavors='check check_format format flake docs'

[build]
command='/usr/bin/pip install --root-user-action=ignore --prefix=. .'

[check]
command='pylint \
        pacemaker_helper \
        rbd_helper \
        vm_manager'

[check_format]
command='black -l 79 -t py38 --check .'

[format]
command='black -l 79 -t py38 .'

[flake]
command='python3 -m flake8 --ignore=E501,W503'

[docs]
command='sphinx-build -b html docs docs/_build/html'
